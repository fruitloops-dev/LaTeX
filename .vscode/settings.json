{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,

  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.autoBuild.interval": 800,
  "latex-workshop.latex.build.rootfileInStatus": true,
  "latex-workshop.latex.outDir": "%DIR%/output/pdf",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (LuaLaTeX · TeX Live 2026)",
      "tools": [
        "latexmk-lualatex-2026"
      ]
    },
    {
      "name": "latexmk (pdfLaTeX · TeX Live 2026)",
      "tools": [
        "latexmk-pdflatex-2026"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex-2026",
      "command": "D:/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "LC_ALL": "C",
        "LANG": "C"
      }
    },
    {
      "name": "latexmk-pdflatex-2026",
      "command": "D:/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "LC_ALL": "C",
        "LANG": "C"
      }
    }
  ],

  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.view.pdf.zoom": "page-width",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

  "[latex]": {
    "editor.wordWrap": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false
  }
}
